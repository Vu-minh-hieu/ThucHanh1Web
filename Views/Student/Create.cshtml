@{
    ViewData["Title"] = "Student List";
    Layout = "~/Views/Shared/MyLayout.cshtml";
}
@model Student
<div>
    <div asp-validation-summary="All" class="text-danger"></div>
    <form asp-controller="Student" asp-action="Create" method="post" enctype="multipart/form-data" class="mt-3">
    @* <form asp-route="StudentAddPost" method="post" enctype="multipart/form-data" class="mt-3"> *@

        <div style="margin-top:7px" class="form-group row">
            <div class="col-sm-2 col-form-label">Họ tên</div>
            <div class="col-sm-10">
                <input asp-for="Name" class="form-control" placeholder="Họ tên" />
            </div>
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div style="margin-top:7px" class="form-group row">
            <div class="col-sm-2 col-form-label">Email</div>
            <div class="col-sm-10">
                <input asp-for="Email" class="form-control" placeholder="Email" />
            </div>
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div style="margin-top:7px" class="form-group row">
            <div class="col-sm-2 col-form-label">Password</div>
            <div class="col-sm-10">
                <input asp-for="Password" class="form-control" placeholder="Password" />
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div style="margin-top:7px" class="form-group row">
            <div class="col-sm-2 col-form-label">Branch</div>
            <div class="col-sm-10">
                <select asp-for="Branch" asp-items="ViewBag.AllBranches"></select>
            </div>
        </div>

        <div style="margin-top:7px" class="form-group row">
            <label asp-for="IsRegular" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input type="checkbox" class="custom-control-input" asp-for="IsRegular">
            </div>
            <span asp-validation-for="IsRegular" class="text-danger"></span>
        </div>

        <div style="margin-top:7px" class="form-group row">
            <div class="col-sm-2 col-form-label">Date Of Birth</div>
            <div class="col-sm-10">
                <input asp-for="DateOfBirth" class="form-control" />
            </div>
            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
        </div>

        <div style="margin-top:7px" class="form-group row">
            <div class="col-sm-2 col-form-label">Gender</div>
            <div class="col-sm-10">
                @foreach (var gender in ViewBag.AllGenders)
                {
                    <label class="form-check-inline">
                        <input type="radio" asp-for="Gender" value="@gender" /> @gender
                    </label>
                }
            </div>
            <span asp-validation-for="Gender" class="text-danger"></span>
        </div>

        <div style="margin-top:7px" class="form-group row">
            <div class="col-sm-2 col-form-label">Address</div>
            <div class="col-sm-10">
                <textarea asp-for="Address" class="form-control"></textarea>
            </div>
        </div>

        <div style="margin-top:7px" class="form-group row">
            <div class="col-sm-2 col-form-label">Điểm</div>
            <div class="col-sm-10">
                <input asp-for="Score" class="form-control" placeholder="Điểm" />
            </div>
            <span asp-validation-for="Score" class="text-danger"></span>
        </div>

        <div style="margin-top:7px" class="form-group row">
            <div class="col-sm-2 col-form-label">Ảnh đại diện</div>
            <div class="col-sm-10">
                <input type="file" name="AvatarFile" class="form-control" />
            </div>
        </div>

        <div style="margin-top:7px" class="form-group row">
            <div class="col-sm-10">
                <button type="submit" class="btn btn-primary">Create</button>
            </div>
        </div>
    </form>
</div>