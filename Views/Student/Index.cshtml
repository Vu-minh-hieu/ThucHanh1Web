@{
    ViewData["Title"] = "Student List";
    Layout = "~/Views/Shared/MyLayout.cshtml";
}
@section Scripts{
    <script>
        var table = document.querySelector("table");
        table.onclick = function onTableClick(){
            table.style = "background-color: yellow;"
        }
    </script>
}
@model IEnumerable<Student>
@* <a href="/Admin/Student/Add" class="btn btn-primary">Create Student</a> *@
<a asp-controller="Student" asp-action="Create" class="btn btn-primary">Create Student</a>
@* <a asp-route="StudentAddGet" class="btn btn-primary">Create Student</a> *@
<table class="table table-striped">
    <thead>
        <tr>
            <th>Mã</th>
            <th>Họ tên</th>
            <th>Ngày sinh</th>
            <th>Giới tính</th>
            <th>Hệ ĐT</th>
            <th>Ngành</th>
            <th>Địa chỉ</th>
            <th>Email</th>
            <th>Ảnh</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Id</td>
                <td>@s.Name</td>
                <td>@s.DateOfBirth</td>
                <td>
                    @(s.Gender == Gender.Male ? "Nam" : "Nữ")
                </td>
                <td>
                    @(s.IsRegular ? "Chính quy" : "Phi chính quy")
                </td>
                <td>
                    @{
                        string str = "";
                        switch (s.Branch)
                        {
                            case Branch.IT:
                                str = "CNTT";
                                break;
                            case Branch.BE:
                                str = "Kinh tế";
                                break;
                            case Branch.CE:
                                str = "Công trình";
                                break;
                            case Branch.EE:
                                str = "Điện tử";
                                break;
                        }
                    }
                    @str
                </td>
                <td>@s.Address</td>
                <td>@s.Email</td>
                <td>@s.Score</td>
                <td>
                    @if (!string.IsNullOrEmpty(s.Avatar))
                    {
                        <img src="~/images/@s.Avatar" width="80" height="80" />
                    }
                    else
                    {
                        <span>Chưa có ảnh</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
